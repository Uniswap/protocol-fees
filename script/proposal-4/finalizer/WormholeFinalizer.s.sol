pragma solidity 0.8.29;

import {Script, console2} from "lib/forge-std/src/Script.sol";

import "../Constants.sol" as Constants;
import {
  IUniswapV2Factory,
  IUniswapV3Factory,
  IUniswapV4PoolManager
} from "../Interfaces.sol";

interface IUniswapWormholeMessageReceiver {
    function receiveMessage(bytes calldata whMessage) external payable;
}

IUniswapWormholeMessageReceiver constant CELO_WORMHOLE_RECEIVER = IUniswapWormholeMessageReceiver(Constants.Celo.UNISWAP_WORMHOLE_MESSAGE_RECEIVER);
IUniswapWormholeMessageReceiver constant BNB_CHAIN_WORMHOLE_RECEIVER = IUniswapWormholeMessageReceiver(Constants.BNB.UNISWAP_WORMHOLE_MESSAGE_RECEIVER);

uint256 constant CELO_CHAIN_ID = 42220;
uint256 constant BNB_CHAIN_CHAIN_ID = 56;

bytes constant BNB_CHAIN_VAA = hex"";
bytes constant CELO_VAA = hex"";

contract WormholeFinalizer is Script {
    function run() external {
        if (block.chainid == CELO_CHAIN_ID) {
            // -------------------------------------------------------------------------------------
            // Send Message to Receiver on Celo Chain
            //
            CELO_WORMHOLE_RECEIVER.receiveMessage(CELO_VAA);

            console2.log("(Celo) Wormhole Message Received.");
        } else if (block.chainid == BNB_CHAIN_CHAIN_ID) {
            // -------------------------------------------------------------------------------------
            // Send Message to Receiver on BNB Chain
            //
            BNB_CHAIN_WORMHOLE_RECEIVER.receiveMessage(BNB_CHAIN_VAA);

            console2.log("(BNB) Wormhole Message Received.");
        } else {
            // -------------------------------------------------------------------------------------
            // Throw if Chain ID is invalid
            //
            revert("WormholeFinalizer::run: block.chainid invalid; expected 42220 (Celo) or 56 (BNB)");
        }
    }
}
